[run]
source =
    adapters
    cli
    compilers
    evaluation
    extraction
    fixtures
    ingestion
    policy_ir
    validation
omit =
    */tests/*
    # Network fetch of the OMG schemas; exercised by the opt-in xsd tests, which
    # need those schemas already on disk.
    scripts/*

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
