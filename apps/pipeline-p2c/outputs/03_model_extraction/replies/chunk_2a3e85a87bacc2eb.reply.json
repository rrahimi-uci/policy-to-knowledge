          "text": "{\"candidates\":[{\"modality\":\"obligation\",\"semantic_kind\":\"documentation_requirement\",\"effect\":\"require_action\",\"display_unit\":1,\"citations\":[{\"role\":\"subject\",\"units\":[1]},{\"role\":\"effect\",\"units\":[1]},{\"role\":\"scope\",\"units\":[1]},{\"role\":\"cross_reference\",\"units\":[0]}],\"subject_ref\":\"lender\",\"action\":\"specify special feature codes (SFC)\",\"object_ref\":\"mortgages delivered to Fannie Mae\",\"condition_ast\":null,\"effect_ast\":null,\"exception_ast\":null,\"temporal_constraint\":null,\"scope\":null,\"effective_period\":null,\"lifecycle\":\"active\",\"compilation_intent\":\"unresolved\",\"authority_ref\":null,\"cross_reference_targets\":[],\"missing\":[\"condition\"]},{\"modality\":\"definition\",\"semantic_kind\":\"unclassified\",\"effect\":\"no_direct_effect\",\"display_unit\":0,\"citations\":[{\"role\":\"subject\",\"units\":[0]},{\"role\":\"effect\",\"units\":[0]}],\"subject_ref\":\"special deposit account\",\"action\":\"is established for renovation mortgages to hold the funds needed for the renovation work\",\"object_ref\":\"funds can be disbursed from time to time as particular portions of the work are completed\",\"condition_ast\":null,\"effect_ast\":null,\"exception_ast\":null,\"temporal_constraint\":null,\"scope\":null,\"effective_period\":null,\"lifecycle\":\"active\",\"compilation_intent\":\"graph_only\",\"authority_ref\":null,\"cross_reference_targets\":[],\"missing\":[]},{\"modality\":\"definition\",\"semantic_kind\":\"unclassified\",\"effect\":\"no_direct_effect\",\"display_unit\":0,\"citations\":[{\"role\":\"subject\",\"units\":[0]},{\"role\":\"effect\",\"units\":[0]}],\"subject_ref\":\"special feature codes (SFC)\",\"action\":\"are codes that Fannie Mae uses to identify certain characteristics related to\",\"object_ref\":\"individual mortgage loans, mortgage products, or negotiated transactions\",\"condition_ast\":null,\"effect_ast\":null,\"exception_ast\":null,\"temporal_constraint\":null,\"scope\":null,\"effective_period\":null,\"lifecycle\":\"active\",\"compilation_intent\":\"graph_only\",\"authority_ref\":null,\"cross_reference_targets\":[],\"missing\":[]},{\"modality\":\"definition\",\"semantic_kind\":\"unclassified\",\"effect\":\"no_direct_effect\",\"display_unit\":4,\"citations\":[{\"role\":\"subject\",\"units\":[4]},{\"role\":\"effect\",\"units\":[4]}],\"subject_ref\":\"standard remittance cycle\",\"action\":\"is a payment cycle used for scheduled/scheduled remittance types for MBS pools that requires\",\"object_ref\":\"scheduled and unscheduled payments to be remitted to Fannie Mae on the 18th calendar day of each month (or on the preceding business day if the 18th is not a business day)\",\"condition_ast\":null,\"effect_ast\":null,\"exception_ast\":null,\"temporal_constraint\":null,\"scope\":null,\"effective_period\":null,\"lifecycle\":\"active\",\"compilation_intent\":\"graph_only\",\"authority_ref\":null,\"cross_reference_targets\":[],\"missing\":[]},{\"modality\":\"definition\",\"semantic_kind\":\"unclassified\",\"effect\":\"no_direct_effect\",\"display_unit\":9,\"citations\":[{\"role\":\"subject\",\"units\":[9]},{\"role\":\"effect\",\"units\":[9,10]},{\"role\":\"exception\",\"units\":[11]}],\"subject_ref\":\"third-party origination\",\"action\":\"is a loan that is completely or partially originated, processed, underwritten, packaged, funded, or closed by\",\"object_ref\":\"an entity other than the seller (or its parent company, controlled affiliate or subsidiary) that sells the loan to Fannie Mae (including mortgage brokers or correspondents, known as third-party originators)\",\"condition_ast\":null,\"effect_ast\":null,\"exception_ast\":{\"kind\":\"literal\",\"value\":\"Loans are not considered third-party originations if a seller enters into a contract with a third party known for the quality of its underwriting (such as a mortgage insurer) to help the seller in underwriting its mortgage originations.\",\"type\":\"string\",\"unit\":null},\"temporal_constraint\":null,\"scope\":null,\"effective_period\":null,\"lifecycle\":\"active\",\"compilation_intent\":\"graph_only\",\"authority_ref\":null,\"cross_reference_targets\":[],\"missing\":[]},{\"modality\":\"definition\",\"semantic_kind\":\"unclassified\",\"effect\":\"no_direct_effect\",\"display_unit\":13,\"citations\":[{\"role\":\"subject\",\"units\":[13]},{\"role\":\"effect\",\"units\":[13,14]}],\"subject_ref\":\"transfer of ownership\",\"action\":\"is any means by which the ownership of property changes hands; Fannie Mae considers transfer of all or any part of the property or any interest in the property to be a transfer of ownership\",\"object_ref\":\"including the purchase of a property “subject to” the mortgage, the assumption of the mortgage debt by the property purchaser, and any exchange of possession of the property under a land sales contract, grant deed, or any other land trust device; and, when a revocable trust is the borrower, any transfer of a beneficial interest in the trust\",\"condition_ast\":null,\"effect_ast\":null,\"exception_ast\":null,\"temporal_constraint\":null,\"scope\":null,\"effective_period\":null,\"lifecycle\":\"active\",\"compilation_intent\":\"graph_only\",\"authority_ref\":\"Fannie Mae\",\"cross_reference_targets\":[],\"missing\":[]},{\"modality\":\"definition\",\"semantic_kind\":\"unclassified\",\"effect\":\"no_direct_effect\",\"display_unit\":23,\"citations\":[{\"role\":\"subject\",\"units\":[23]},{\"role\":\"effect\",\"units\":[23,24]}],\"subject_ref\":\"value acceptance\",\"action\":\"is an optional offer to sell the loan without an appraisal for certain loan casefiles underwritten in DU\",\"object_ref\":\"based on data and a modeling framework that confirms the validity of the value/sale price\",\"condition_ast\":null,\"effect_ast\":null,\"exception_ast\":null,\"temporal_constraint\":null,\"scope\":null,\"effective_period\":null,\"lifecycle\":\"active\",\"compilation_intent\":\"graph_only\",\"authority_ref