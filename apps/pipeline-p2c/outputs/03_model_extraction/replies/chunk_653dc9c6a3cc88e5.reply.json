          "text": "{\"candidates\":[{\"modality\":\"obligation\",\"semantic_kind\":\"decision_rule\",\"effect\":\"require_action\",\"display_unit\":1,\"citations\":[{\"role\":\"condition\",\"units\":[1]},{\"role\":\"subject\",\"units\":[1]},{\"role\":\"effect\",\"units\":[1]}],\"subject_ref\":\"each party\",\"action\":\"remain liable\",\"object_ref\":\"breaches of the Agreement that occurred prior to such termination\",\"condition_ast\":{\"kind\":\"literal\",\"value\":\"Upon termination of this Agreement\",\"type\":\"string\",\"unit\":null},\"effect_ast\":null,\"exception_ast\":null,\"temporal_constraint\":null,\"scope\":null,\"effective_period\":null,\"lifecycle\":\"unknown\",\"compilation_intent\":\"unresolved\",\"authority_ref\":null,\"cross_reference_targets\":[],\"missing\":[]},{\"modality\":\"obligation\",\"semantic_kind\":\"decision_rule\",\"effect\":\"require_action\",\"display_unit\":2,\"citations\":[{\"role\":\"condition\",\"units\":[2]},{\"role\":\"subject\",\"units\":[2]},{\"role\":\"effect\",\"units\":[2]}],\"subject_ref\":\"a breaching party\",\"action\":\"indemnify\",\"object_ref\":\"the non-breaching party\",\"condition_ast\":{\"kind\":\"literal\",\"value\":\"Termination of this Agreement\",\"type\":\"string\",\"unit\":null},\"effect_ast\":{\"kind\":\"literal\",\"value\":\"Termination of this Agreement shall not release a breaching party from its obligation to indemnify the non-breaching party\",\"type\":\"string\",\"unit\":null},\"exception_ast\":null,\"temporal_constraint\":null,\"scope\":null,\"effective_period\":null,\"lifecycle\":\"unknown\",\"compilation_intent\":\"unresolved\",\"authority_ref\":null,\"cross_reference_targets\":[],\"missing\":[]},{\"modality\":\"permission\",\"semantic_kind\":\"decision_rule\",\"effect\":\"allow\",\"display_unit\":2,\"citations\":[{\"role\":\"condition\",\"units\":[2]},{\"role\":\"subject\",\"units\":[2]},{\"role\":\"effect\",\"units\":[2]}],\"subject_ref\":\"the non-breaching party\",\"action\":\"receive reimbursement and payment\",\"object_ref\":\"all sums that it would have been entitled to receive under this Agreement prior to termination\",\"condition_ast\":{\"kind\":\"literal\",\"value\":\"Termination of this Agreement\",\"type\":\"string\",\"unit\":null},\"effect_ast\":{\"kind\":\"literal\",\"value\":\"the non-breaching party shall be entitled to receive reimbursement and payment for all sums that it would have been entitled to receive under this Agreement prior to termination\",\"type\":\"string\",\"unit\":null},\"exception_ast\":null,\"temporal_constraint\":null,\"scope\":null,\"effective_period\":null,\"lifecycle\":\"unknown\",\"compilation_intent\":\"unresolved\",\"authority_ref\":null,\"cross_reference_targets\":[],\"missing\":[]},{\"modality\":\"definition\",\"semantic_kind\":\"unclassified\",\"effect\":\"no_direct_effect\",\"display_unit\":3,\"citations\":[{\"role\":\"condition\",\"units\":[3]},{\"role\":\"effect\",\"units\":[3]}],\"subject_ref\":\"this Agreement (together with the attachments and schedules)\",\"action\":\"constitutes\",\"object_ref\":\"the entire Agreement between the parties pertaining to the subject matter hereof and supersedes any and all prior agreements, representations, and understanding of the parties, written or oral\",\"condition_ast\":{\"kind\":\"literal\",\"value\":\"Except as set forth herein\",\"type\":\"string\",\"unit\":null},\"effect_ast\":null,\"exception_ast\":null,\"temporal_constraint\":null,\"scope\":null,\"effective_period\":null,\"lifecycle\":\"unknown\",\"compilation_intent\":\"unresolved\",\"authority_ref\":null,\"cross_reference_targets\":[],\"missing\":[]},{\"modality\":\"obligation\",\"semantic_kind\":\"decision_rule\",\"effect\":\"produce_value\",\"display_unit\":4,\"citations\":[{\"role\":\"condition\",\"units\":[4]},{\"role\":\"effect\",\"units\":[4]}],\"subject_ref\":null,\"action\":\"apply order of precedence\",\"object_ref\":\"(i) the Guides, (ii) this Agreement, (iii) the attachments or schedules hereto, and (iv) the Servicing Transfer Instructions\",\"condition_ast\":{\"kind\":\"literal\",\"value\":\"In the event of a conflict between this Agreement, the attachments or schedules hereto, the Fannie Mae Guides and the Servicing Transfer Instructions\",\"type\":\"string\",\"unit\":null},\"effect_ast\":{\"kind\":\"literal\",\"value\":\"order of precedence shall be: (i) the Guides, (ii) this Agreement, (iii) the attachments or schedules hereto, and (iv) the Servicing Transfer Instructions\",\"type\":\"string\",\"unit\":null},\"exception_ast\":null,\"temporal_constraint\":null,\"scope\":null,\"effective_period\":null,\"lifecycle\":\"unknown\",\"compilation_intent\":\"unresolved\",\"authority_ref\":null,\"cross_reference_targets\":[\"the Guides\",\"this Agreement\",\"the attachments or schedules hereto\",\"the Servicing Transfer Instructions\"],\"missing\":[\"subject\"]},{\"modality\":\"prohibition\",\"semantic_kind\":\"validation\",\"effect\":\"deny\",\"display_unit\":5,\"citations\":[{\"role\":\"effect\",\"units\":[5]},{\"role\":\"exception\",\"units\":[5]}],\"subject_ref\":null,\"action\":\"be binding\",\"object_ref\":\"addendum, supplement, modification or amendment of this Agreement\",\"condition_ast\":null,\"effect_ast\":{\"kind\":\"literal\",\"value\":\"No addendum, supplement, modification or amendment of this Agreement shall be binding\",\"type\":\"string\",\"unit\":null},\"exception_ast\":{\"kind\":\"literal\",\"value\":\"unless executed in writing by the parties hereto\",\"type\":\"string\",\"unit\":null},\"temporal_constraint\":null,\"scope\":null,\"effective_period\":null,\"lifecycle\":\"unknown\",\"compilation_intent\":\"unresolved\",\"authority_ref\":null,\"cross_reference_targets\":[],\"missing\":[\"subject\"]},{\"modality\":\"prohibition\",\"semantic_kind\":\"authority_statement\",\"effect\":\"deny\",\"display_unit\":6,\"citations\":[{\"role\":\"effect\",\"units\":[6]}],\"subject_ref\":\"this Agreement\",\"action\":\"affect or supersede\",\"object_ref\":\"