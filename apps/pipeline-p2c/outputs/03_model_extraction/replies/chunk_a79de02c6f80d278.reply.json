          "annotations": [],
          "logprobs": [],
          "text": "{\"candidates\":[{\"modality\":\"definition\",\"semantic_kind\":\"validation\",\"effect\":\"no_direct_effect\",\"display_unit\":2,\"citations\":[{\"role\":\"subject\",\"units\":[1]},{\"role\":\"effect\",\"units\":[2]}],\"subject_ref\":\"Seller\",\"action\":\"represents and warrants\",\"object_ref\":\"The Mortgage Loan meets all requirements of the applicable Purchase Documents, as amended and in effect at the time the Mortgage Loan was sold.\",\"condition_ast\":null,\"effect_ast\":null,\"exception_ast\":null,\"temporal_constraint\":null,\"scope\":null,\"effective_period\":null,\"lifecycle\":\"unknown\",\"compilation_intent\":\"graph_only\",\"authority_ref\":null,\"cross_reference_targets\":[],\"missing\":[]},{\"modality\":\"definition\",\"semantic_kind\":\"validation\",\"effect\":\"no_direct_effect\",\"display_unit\":4,\"citations\":[{\"role\":\"subject\",\"units\":[1]},{\"role\":\"effect\",\"units\":[4]}],\"subject_ref\":\"Seller\",\"action\":\"represents and warrants\",\"object_ref\":\"There was no fraud or misrepresentation in the origination of the Mortgage Loan, whether or not as a result of any act or omission of Seller, a prior originator, the mortgagor, or any employee, representative or agent of the foregoing, as would materially impair the Mortgage Loan or the related Mortgage Insurance contract.\",\"condition_ast\":null,\"effect_ast\":null,\"exception_ast\":null,\"temporal_constraint\":null,\"scope\":null,\"effective_period\":null,\"lifecycle\":\"unknown\",\"compilation_intent\":\"graph_only\",\"authority_ref\":null,\"cross_reference_targets\":[],\"missing\":[]},{\"modality\":\"definition\",\"semantic_kind\":\"validation\",\"effect\":\"no_direct_effect\",\"display_unit\":6,\"citations\":[{\"role\":\"subject\",\"units\":[1]},{\"role\":\"effect\",\"units\":[6]}],\"subject_ref\":\"Seller\",\"action\":\"represents and warrants\",\"object_ref\":\"The Mortgage Loan shall not have been delinquent (more than 30 days past due) within one year of the Purchase Date.\",\"condition_ast\":null,\"effect_ast\":null,\"exception_ast\":null,\"temporal_constraint\":null,\"scope\":null,\"effective_period\":null,\"lifecycle\":\"unknown\",\"compilation_intent\":\"graph_only\",\"authority_ref\":null,\"cross_reference_targets\":[],\"missing\":[\"temporal\"]},{\"modality\":\"definition\",\"semantic_kind\":\"validation\",\"effect\":\"no_direct_effect\",\"display_unit\":8,\"citations\":[{\"role\":\"subject\",\"units\":[1]},{\"role\":\"effect\",\"units\":[8]}],\"subject_ref\":\"Seller\",\"action\":\"represents and warrants\",\"object_ref\":\"Seller has not committed any act or failed to commit an act in connection with the Mortgage Loan which would cause Fannie Mae to request a repurchase of the Mortgage Loan.\",\"condition_ast\":null,\"effect_ast\":null,\"exception_ast\":null,\"temporal_constraint\":null,\"scope\":null,\"effective_period\":null,\"lifecycle\":\"unknown\",\"compilation_intent\":\"graph_only\",\"authority_ref\":null,\"cross_reference_targets\":[],\"missing\":[]}]}",
